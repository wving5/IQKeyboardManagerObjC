  "license": "MIT",
  "authors": {
    "Iftekhar Qurashi": "hack.iftekhar@gmail.com"
  },
  "platforms": {
    "ios": "11.0"
  },
  "source_files": "IQKeyboardManagerObjC/**/*.{h,m}",
  "resource_bundles": {"IQKeyboardManager": "IQKeyboardManagerObjC/PrivacyInfo.xcprivacy"},
  "public_header_files": [
      "IQKeyboardManagerObjC/IQKeyboardManager.h",
      "IQKeyboardManagerObjC/IQKeyboardReturnKeyHandler.h",
      "IQKeyboardManagerObjC/Categories/IQUIScrollView+Additions.h",
      "IQKeyboardManagerObjC/Categories/IQUITextFieldView+Additions.h",
